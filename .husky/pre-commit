#!/bin/sh

# Pre-commit hook for oh-my-customcodex
# Runs typecheck, lint, and stable CI-aligned test batches before allowing commit

# Worktree detection: .git is a file (not directory) in worktrees
if [ -f .git ]; then
    echo "Running pre-commit checks (worktree mode)..."
    bun run typecheck 2>/dev/null || exit 1
    echo "Worktree pre-commit passed (typecheck only — full suite runs in CI)."
    exit 0
fi

echo "Running pre-commit checks..."

# Run TypeScript type checking
echo "Checking types..."
bun run typecheck
if [ $? -ne 0 ]; then
    echo "Type check failed. Please fix the errors before committing."
    exit 1
fi

# Auto-fix lint issues on staged files
echo "Running lint auto-fix..."

# Collect staged files by type
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)

# TypeScript/JavaScript: Biome
if [ -n "$STAGED_TS" ]; then
    echo "  [Biome] Formatting $(echo "$STAGED_TS" | wc -l | tr -d ' ') files..."
    echo "$STAGED_TS" | xargs npx biome check --write --no-errors-on-unmatched 2>/dev/null
    echo "$STAGED_TS" | xargs git add -f
fi

# Python: Ruff
if [ -n "$STAGED_PY" ]; then
    if command -v ruff >/dev/null 2>&1; then
        echo "  [Ruff] Formatting $(echo "$STAGED_PY" | wc -l | tr -d ' ') files..."
        echo "$STAGED_PY" | xargs ruff check --fix --quiet 2>/dev/null
        echo "$STAGED_PY" | xargs ruff format --quiet 2>/dev/null
        echo "$STAGED_PY" | xargs git add -f
    fi
fi

# Go: gofmt
if [ -n "$STAGED_GO" ]; then
    if command -v gofmt >/dev/null 2>&1; then
        echo "  [gofmt] Formatting $(echo "$STAGED_GO" | wc -l | tr -d ' ') files..."
        echo "$STAGED_GO" | xargs gofmt -w 2>/dev/null
        echo "$STAGED_GO" | xargs git add -f
    fi
fi

# Final lint check (should pass after auto-fix)
bun run lint
if [ $? -ne 0 ]; then
    echo "Lint errors remain after auto-fix. Please fix manually."
    exit 1
fi

# Run tests in the same stable batches used by CI. Full-suite `bun test --coverage`
# on this imported harness tree is still unstable and legacy CLAUDE.md/.claude
# count parsing no longer matches the codex-only repo root.
echo "Running tests in stable batches..."

run_bun_batch() {
    label="$1"
    shift
    log_file=$(mktemp)

    echo "  [$label]"
    bun test "$@" >"$log_file" 2>&1
    TEST_EXIT_CODE=$?
    cat "$log_file"

    if [ $TEST_EXIT_CODE -ne 0 ]; then
        if grep -qE "\\([Ff]ail\\)|[0-9]+ fail" "$log_file"; then
            rm -f "$log_file"
            echo "Tests failed in batch: $label"
            exit 1
        fi

        if grep -qE "\\(pass\\)|[0-9]+ pass" "$log_file"; then
            echo "  [warn] $label exited with $TEST_EXIT_CODE but only passing-test evidence was observed; continuing."
        else
            rm -f "$log_file"
            echo "Tests failed before any passing-test evidence was observed: $label"
            exit 1
        fi
    fi

    rm -f "$log_file"
}

run_bun_batch "sync-integration-e2e" \
    tests/sync-upstream-release-issues.test.js \
    tests/integration/i18n.test.ts \
    tests/integration/init-flow.test.ts \
    tests/e2e/list.test.ts \
    tests/e2e/doctor.test.ts

run_bun_batch "cli-update" tests/unit/cli/update.test.ts
run_bun_batch "cli-projects" tests/unit/cli/projects.test.ts tests/unit/cli/projects-command.test.ts
run_bun_batch "cli-serve" tests/unit/cli/serve.test.ts
run_bun_batch "cli-serve-commands" tests/unit/cli/serve-commands.test.ts
run_bun_batch "cli-web-commands" tests/unit/cli/web-commands.test.ts

# Git-backed snapshot/root tests use real child processes. Keep them outside
# batches containing process-wide Bun mocks.
run_bun_batch "cli-init-snapshot" tests/unit/cli/init-snapshot.test.ts
run_bun_batch "codex-project-root" tests/unit/core/codex-project-root.test.ts

run_bun_batch "cli-doctor-init-list-security" \
    tests/unit/cli/doctor.test.ts \
    tests/unit/cli/doctor-checks.test.ts \
    tests/unit/cli/doctor-updates.test.ts \
    tests/unit/cli/init.test.ts \
    tests/unit/cli/list.test.ts \
    tests/unit/cli/list-managed.test.ts \
    tests/unit/cli/security.test.ts

# Git-backed linked hook regressions invoke real child processes and must not
# share Bun's process with suites that install process-wide mocks.
run_bun_batch "native-linked-hooks" \
    tests/unit/core/codex-hooks-integration.test.ts \
    tests/unit/core/sync.test.ts

run_bun_batch "core-update-registry-template-hooks" \
    tests/unit/core/hooks-scripts.test.ts \
    tests/unit/core/hooks-validation.test.ts \
    tests/unit/core/package-contract.test.ts \
    tests/unit/core/setup-hooks.test.ts \
    tests/unit/core/template-validation.test.ts \
    tests/unit/core/registry.test.ts \
    tests/unit/core/self-update.test.ts \
    tests/unit/core/self-update-integration.test.ts \
    tests/unit/core/updater.test.ts \
    tests/unit/core/entry-doc-update.test.ts

run_bun_batch "core-config-installer-utils" \
    tests/unit/core/config.test.ts \
    tests/unit/core/installer.test.ts \
    tests/unit/core/installer-rtk-codex.test.ts \
    tests/unit/core/lockfile.test.ts \
    tests/unit/core/mcp-config.test.ts \
    tests/unit/core/preflight.test.ts \
    tests/unit/core/preflight-brew.test.ts \
    tests/unit/core/provider.test.ts \
    tests/unit/core/doctor-framework.test.ts \
    tests/unit/utils/fs.test.ts \
    tests/unit/utils/logger.test.ts \
    tests/unit/i18n/index.test.ts

echo "All pre-commit checks passed!"
